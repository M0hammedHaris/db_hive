# .env.example — example local environment variables for DB Hive

# Backend
DATABASE_URL=postgres://dev:dev@localhost:5432/dbhive
NEON_DATABASE_URL=
SECRET_KEY_BASE=changeme

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:3001

# Auth (Clerk)
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# LLM
LLM_PROVIDER=openai
LLM_API_KEY=sk-xxxxx
LLM_BUDGET_LIMIT=100

# Observability
SENTRY_DSN=

# Local dev toggles
DEV_SSH_SIMULATOR_HOST=localhost
DEV_SSH_SIMULATOR_PORT=2222
DEV_SSH_SIMULATOR_USER=sim
DEV_SSH_SIMULATOR_KEY_PATH=~/.ssh/id_rsa_sim
